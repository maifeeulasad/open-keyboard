<?xml version="1.0" encoding="utf-8"?>
<!--
  IBus component descriptor for open-keyboard.
  `@LIBEXEC@` is replaced with the installed engine path by packaging/install.sh.
  Installed to: /usr/share/ibus/component/open-keyboard.xml
-->
<component>
  <name>org.freedesktop.IBus.OpenKeyboard</name>
  <description>open-keyboard Bengali input method</description>
  <exec>@LIBEXEC@/okb-ibus-engine --ibus</exec>
  <version>0.1.0</version>
  <author>Maifee Ul Asad</author>
  <license>GPL-3.0-only</license>
  <homepage>https://github.com/maifeeulasad/open-keyboard</homepage>
  <textdomain>open-keyboard</textdomain>

  <engines>
    <engine>
      <name>open-keyboard-bn</name>
      <language>bn</language>
      <license>GPL-3.0-only</license>
      <author>Maifee Ul Asad</author>
      <layout>us</layout>
      <longname>Bengali (open-keyboard, phonetic)</longname>
      <description>Phonetic Bengali input: type in English, get Bengali.</description>
      <rank>50</rank>
      <symbol>বাং</symbol>
    </engine>
  </engines>
</component>
